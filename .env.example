# ==========================================
# Welfare Scheme & Grievance - Render Environment Variables
# ==========================================

# Database Connection Strings
# Render PostgreSQL Connection String (auto-populated by Render Blueprint)
DATABASE_URL=postgresql://welfare_user:password@dpg-xxx-a.rendercom/welfare_db

# MongoDB Atlas URI (optional - backend uses auto in-memory fallback if empty or unreachable)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/civic_welfare_db?retryWrites=true&w=majority

# Backend Authentication & API Secrets
JWT_SECRET=super_secret_jwt_key_change_in_production
PORT=10000

# Backend -> ML Service Inter-Service Endpoint
PYTHON_ML_URL=https://welfare-scheme-ml.onrender.com

# FastAPI ML Microservice Settings
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Production CORS Security Configuration
FRONTEND_URL=https://welfare-scheme-frontend.onrender.com
CORS_ORIGINS=https://welfare-scheme-frontend.onrender.com

# Frontend Vite Production API URL (Used by Axios in React Frontend)
VITE_API_URL=https://welfare-scheme-backend.onrender.com
